{
  "format": "fluxion-training-preset",
  "version": 1,
  "id": "economy",
  "name": "Экономный",
  "description": "Для видеокарт с 6 ГБ памяти. Обучение через unsloth, контекст 2048 токенов. Хороший выбор для первого дообучения.",
  "trainer": "low",
  "min_vram_gb": 6,
  "base_model": "Qwen/Qwen2.5-Coder-7B-Instruct",
  "settings": {
    "lora_r": 32,
    "lora_alpha": 64,
    "lora_dropout": 0.05,
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj"
    ],
    "max_seq_length": 2048,
    "num_train_epochs": 3,
    "per_device_train_batch_size": 1,
    "gradient_accumulation_steps": 16,
    "learning_rate": 0.0002
  }
}
