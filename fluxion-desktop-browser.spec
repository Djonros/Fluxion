# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller spec for the Fluxion Browser desktop app.

Same stack as fluxion-desktop.spec (GUI + chat + agent + license + RAG store)
plus the embedded QtWebEngine browser panel (desktop_browser package).
"""
import os

block_cipher = None

a = Analysis(
    ["run_desktop_browser.py"],
    pathex=[os.path.abspath(".")],
    binaries=[],
    datas=[
        ("assets", "assets"),
        ("config", "config"),
        ("finetune", "finetune"),
        ("licensing", "licensing"),
    ],
    hiddenimports=[
        "desktop_browser",
        "desktop_browser.app",
        "desktop_browser.banner",
        "desktop_browser.browser",
        "desktop_browser.engine",
        "desktop_browser.license_dialog",
        "desktop_browser.training",
        "PySide6.QtWebEngineWidgets",
        "PySide6.QtWebEngineCore",
        "PySide6.QtWebChannel",
        "web",
        "web.pipeline",
        "web.searxng",
        "web.fetcher",
        "web.cache",
        "finetune",
        "finetune.qlora_config",
        "finetune.dataset_loader",
        "finetune.train_unsloth",
        "finetune.train_hf",
        "finetune.merge",
        "finetune.export_gguf",
        "finetune.marketplace",
        "cli",
        "cli.theme",
        "cli.render",
        "cli.repl",
        "cli.commands",
        "cli.app",
        "core",
        "core.config",
        "core.inference",
        "core.language",
        "core.ollama_client",
        "core.backend_factory",
        "core.llama_cpp_backend",
        "core.model_manager",
        "core.model_runtime",
        "core.update",
        "web.search_backend",
        "orchestrator",
        "orchestrator.assistant",
        "orchestrator.agent",
        "orchestrator.router",
        "orchestrator.strategy",
        "orchestrator.prompt_builder",
        "orchestrator.git_helper",
        "rag",
        "rag.service",
        "rag.chunker",
        "rag.embedder",
        "rag.indexer",
        "rag.retriever",
        "rag.store",
        "chromadb",
        "chromadb.api",
        "chromadb.api.client",
        "chromadb.api.rust",
        "chromadb_rust_bindings",
        "chromadb.execution.expression.plan",
