@echo off
chcp 65001 >nul 2>&1
setlocal EnableExtensions
title Fluxion - проверка перед открытием репозитория
cd /d "%~dp0"

:: ============================================================================
::  Проверка репозитория перед тем, как сделать его публичным
::
::    fluxion-public-check.bat
::
::  Ничего не меняет: только читает git-историю и файлы. Проверяется ВСЯ
::  история (все ветки и теги), а не только текущие файлы: после открытия
::  репозитория любой сможет достать и то, что давно удалено.
::
::  Что ищет:
::    - закрытые ключи, license.key, .env, папки keys\ и data\ в истории;
::    - токены и пароли в тексте (Hugging Face, GitHub, OpenAI и т.п.);
::    - внутренние документы, архивы, сборки и большие файлы;
::    - личные данные: почты авторов коммитов, пути вида C:\Users\...
::
::  Отчёт: logs\public-check-<дата>.txt
::  Код возврата: 0 - стоп-пунктов нет, 1 - есть, 2 - проверка не запустилась.
:: ============================================================================

if not exist "scripts\check_public.ps1" goto :no_script
git --version >nul 2>&1
if errorlevel 1 goto :no_git

powershell -NoProfile -ExecutionPolicy Bypass -File "scripts\check_public.ps1"
set "RC=%ERRORLEVEL%"
echo.
if "%RC%"=="0" echo Стоп-пунктов нет. Прочитайте предупреждения выше и решите по каждому.
if "%RC%"=="1" echo ЕСТЬ СТОП-ПУНКТЫ: репозиторий открывать нельзя, пока они не устранены.
if "%RC%"=="2" echo Проверка не выполнена, см. сообщение выше.
echo.
pause
exit /b %RC%

:no_script
echo [ОШИБКА] Не найден scripts\check_public.ps1 - обновите программу.
pause
exit /b 2

:no_git
echo [ОШИБКА] Git не найден. Установите Git и запустите снова.
pause
exit /b 2
