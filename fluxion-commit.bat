@echo off
chcp 65001 >nul 2>&1
setlocal EnableExtensions
title Fluxion - коммит и отправка
cd /d "%~dp0"

:: ============================================================================
::  Коммит выбранных изменений и отправка в main
::
::    fluxion-commit.bat                - покажет изменения, спросит, что и с каким
::                                        описанием коммитить, и отправлять ли в main
::    fluxion-commit.bat "Описание"     - то же, описание уже задано
::
::  Файлы, где изменились только окончания строк, не показываются. Отправка
::  обычная, без перезаписи: если на GitHub есть новые коммиты, ваш ставится
::  поверх; при конфликте ничего не отправляется и не теряется.
:: ============================================================================

powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0scripts\commit.ps1" %*
set "RC=%ERRORLEVEL%"
echo.
pause
exit /b %RC%
