# --- Ollama ---
OLLAMA_HOST=http://localhost:11434

# --- Model ---
MODEL=qwen2.5-coder:7b-instruct

# --- Backend selection ---
# FLUXION_BACKEND=ollama     # ollama (default), api, llama_cpp

# --- API backend (OpenRouter / Together / Groq / vLLM) ---
# FLUXION_API_KEY=sk-...
# FLUXION_API_BASE_URL=https://openrouter.ai/api/v1
# FLUXION_API_MODEL=qwen/qwen2.5-coder-7b-instruct

# --- llama.cpp backend (direct GGUF inference) ---
# FLUXION_GGUF_PATH=/path/to/model.gguf
# FLUXION_N_GPU_LAYERS=0

# --- Hugging Face (embeddings, datasets, training) ---
# Get a token at https://huggingface.co/settings/tokens
HF_TOKEN=

# --- SearXNG (web search, Phase 4) ---
SEARXNG_URL=http://localhost:8080

# --- Database (Web App) ---
# Leave empty for SQLite (dev). Set for PostgreSQL (production).
# FLUXION_DB_URL=postgresql+psycopg2://fluxion:fluxion@localhost:5432/fluxion

# --- JWT (Web App auth) ---
# Change this to a long random string in production!
FLUXION_JWT_SECRET=fluxion-dev-secret-change-in-production

# --- Stripe billing (Web Phase 5) ---
# Get keys at https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs for paid plans (Stripe Dashboard → Products → Pricing)
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_TEAM=price_...
# STRIPE_PRICE_ENTERPRISE=price_...
