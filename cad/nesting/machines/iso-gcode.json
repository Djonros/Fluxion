    "(Fluxion: {title})",
    "G21",
    "G90",
    "G40"
  ],
  "program_end": [
    "G00 X0. Y0.",
    "M30"
  ],
  "cut_start": [
    "G00 X{x} Y{y}",
    "(Seq {seq} - {name})",
    "F{feed}",
    "M03"
  ],
  "cut_end": [
    "M05"
  ],
  "thc_off": "",
  "thc_off_before_end": 0,
  "line": "G01",
  "arc_cw": "G02",
  "arc_ccw": "G03",
  "modal_motion": true,
  "modal_axes": true,
  "arc_center": "incremental",
  "arcs": true,
  "line_numbers": false,
