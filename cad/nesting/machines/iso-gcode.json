{
  "id": "iso-gcode",
  "name": "Общий G-code (ISO, Mach3 / PUMOTIX / LinuxCNC)",
  "process": "plasma",
  "extension": ".nc",
  "encoding": "ascii",
  "newline": "\r\n",
  "non_ascii": "translit",
  "decimals": 3,
  "separator": " ",
