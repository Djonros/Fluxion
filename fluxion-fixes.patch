+    for name in tool_names:
+        desc, fields = TOOL_SPECS[name]
+        lines.append(f"- {name}: {desc}")
+        for fname, ftype, req, fdesc in fields:
+            opt = "" if req else ", optional"
+            lines.append(f"    {fname} ({ftype}{opt}): {fdesc}")
+    lines += [
